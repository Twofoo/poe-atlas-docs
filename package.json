{
  "name": "poe-atlas-docs",
  "productName": "PoE Atlas Docs",
  "version": "1.0.2",
  "description": "Path of Exile 1 companion: atlas passive tree planner, Word/Excel-style notes and shareable short links",
  "main": "electron/main.cjs",
  "author": "Twofoo",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test tests/atlas.test.mjs tests/bundle.test.mjs",
    "icons": "python scripts/make-icons.py build/icon-source.webp",
    "i18n:check": "node scripts/i18n-keys.mjs"
  },
  "build": {
    "appId": "gg.poe.atlasdocs",
    "productName": "PoE Atlas Docs",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "PoE Atlas Tree",
        "schemes": [
          "poeatlas"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PoE Atlas Docs"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.exe"
    }
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@tiptap/extension-color": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-cell": "^3.33.1",
    "@tiptap/extension-table-header": "^3.33.1",
    "@tiptap/extension-table-row": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1",
    "wrangler": "^4.161.0"
  },
  "type": "module"
}
